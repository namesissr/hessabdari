# اتصال PostgreSQL
DATABASE_URL="postgresql://hesabdari:CHANGE_ME@localhost:5432/hesabdari?schema=public"

# کلید امضای نشست — حداقل ۳۲ کاراکتر تصادفی (مثلاً: openssl rand -hex 32)
SESSION_SECRET=""
SESSION_DAYS=7
# روی HTTPS مقدار true؛ برای اجرای محلی روی http مقدار false
SECURE_COOKIE=false

# کاربر مدیر اولیه (فقط هنگام اولین seed ساخته می‌شود)
ADMIN_EMAIL=admin@hesabdari.local
ADMIN_PASSWORD=

# فقط برای docker compose
POSTGRES_PASSWORD=CHANGE_ME
