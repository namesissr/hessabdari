// حسابداری — سیستم مالی مادر
// اصول: دفتر مال شخصیت حقوقی (Entity) است؛ کسب‌وکار/پروژه/مرکز هزینه «بُعد» هستند.
// مبالغ ریالی BigInt، مقادیر (گرم/واحد/توکن) Decimal. تاریخ‌ها میلادی (@db.Date) ذخیره و شمسی نمایش داده می‌شوند.
// قیود تغییرناپذیری سند قطعی و تراز بودن سند در migrationهای SQL (trigger) پیاده شده‌اند.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── سازمان

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum OwnershipMethod {
  SUBSIDIARY // تلفیق کامل
  ASSOCIATE // ارزش ویژه
  COST // بهای تمام‌شده
}

model Entity {
  id                  String       @id @default(cuid())
  code                String       @unique
  name                String
  legalName           String?
  legalType           String?
  nationalId          String?
  economicCode        String?
  registrationNo      String?
  address             String?
  baseCurrency        String       @default("IRR")
  // پیش‌فرض شروع سال مالی (شمسی) برای پیشنهاد سال بعد — در پنل قابل تغییر
  fiscalStartMonth    Int          @default(1)
  fiscalStartDay      Int          @default(1)
  parentId            String?
  chartId             String
  status              EntityStatus @default(ACTIVE)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  parent          Entity?           @relation("EntityTree", fields: [parentId], references: [id])
  children        Entity[]          @relation("EntityTree")
  chart           Chart             @relation(fields: [chartId], references: [id])
  fiscalYears     FiscalYear[]
  vouchers        Voucher[]
  businessUnits   BusinessUnit[]
  parties         Party[]
  bankAccounts    BankAccount[]
  invoices        Invoice[]
  ingestSources   IngestSource[]
  employees       Employee[]
  payrollRuns     PayrollRun[]
  payrollSettings PayrollSettings[]
  allocationRules AllocationRule[]
  voucherTemplates VoucherTemplate[]
  cheques         Cheque[]
  treasuryTxns    TreasuryTxn[]
  dimensionValues DimensionValue[]
  ownerships      EntityOwnership[] @relation("Owner")
  ownedBy         EntityOwnership[] @relation("Owned")
  userScopes      UserScope[]

  @@map("entities")
}

model EntityOwnership {
  id        String          @id @default(cuid())
  ownerId   String
  ownedId   String
  percent   Decimal         @db.Decimal(9, 4)
  method    OwnershipMethod
  validFrom DateTime        @db.Date
  validTo   DateTime?       @db.Date

  owner Entity @relation("Owner", fields: [ownerId], references: [id])
  owned Entity @relation("Owned", fields: [ownedId], references: [id])

  @@map("entity_ownerships")
}

enum FiscalYearStatus {
  OPEN
  CLOSED
}

enum PeriodStatus {
  OPEN
  LOCKED
  CLOSED
}

model FiscalYear {
  id        String           @id @default(cuid())
  entityId  String
  title     String
  startDate DateTime         @db.Date
  endDate   DateTime         @db.Date
  status    FiscalYearStatus @default(OPEN)
  closedAt  DateTime?
  createdAt DateTime         @default(now())

  entity   Entity         @relation(fields: [entityId], references: [id])
  periods  FiscalPeriod[]
  vouchers Voucher[]

  @@unique([entityId, title])
  @@index([entityId, startDate])
  @@map("fiscal_years")
}

model FiscalPeriod {
  id           String       @id @default(cuid())
  fiscalYearId String
  no           Int
  title        String
  startDate    DateTime     @db.Date
  endDate      DateTime     @db.Date
  status       PeriodStatus @default(OPEN)

  fiscalYear FiscalYear  @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  vouchers       Voucher[]
  balances       GlBalance[]
  allocationRuns AllocationRun[]
  payrollRuns    PayrollRun[]

  @@unique([fiscalYearId, no])
  @@map("fiscal_periods")
}

// ───────────────────────── ابعاد (تفصیلی شناور + مرکز هزینه/درآمد + پروژه + ...)

model DimensionType {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  description    String?
  isHierarchical Boolean  @default(false)
  isSystem       Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  values   DimensionValue[]
  rules    AccountDimensionRule[]
  setItems DimensionSetItem[]

  @@map("dimension_types")
}

model DimensionValue {
  id         String   @id @default(cuid())
  typeId     String
  entityId   String? // null = در سطح کل مجموعه
  code       String
  name       String
  parentId   String?
  attributes Json?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  type         DimensionType      @relation(fields: [typeId], references: [id])
  entity       Entity?            @relation(fields: [entityId], references: [id])
  parent       DimensionValue?    @relation("DimTree", fields: [parentId], references: [id])
  children     DimensionValue[]   @relation("DimTree")
  party        Party?
  bankAccount  BankAccount?
  businessUnit BusinessUnit?
  setItems     DimensionSetItem[]
  userScopes   UserScope[]

  @@unique([typeId, code])
  @@map("dimension_values")
}

enum BusinessKind {
  WEBSITE
  TRADING
  PROJECT
  INVESTMENT
  HEADQUARTERS
  OTHER
}

model BusinessUnit {
  dimensionValueId String       @id
  entityId         String
  kind             BusinessKind @default(WEBSITE)
  domain           String?
  launchedAt       DateTime?    @db.Date
  description      String?

  dimensionValue DimensionValue @relation(fields: [dimensionValueId], references: [id], onDelete: Cascade)
  entity         Entity         @relation(fields: [entityId], references: [id])

  @@map("business_units")
}

// هر ترکیب یکتای مقادیر ابعاد یک بار ذخیره می‌شود؛ ردیف سند فقط شناسهٔ مجموعه را نگه می‌دارد.
model DimensionSet {
  id        Int                @id @default(autoincrement())
  hash      String             @unique
  items     DimensionSetItem[]
  lines     VoucherLine[]
  balances  GlBalance[]

  @@map("dimension_sets")
}

model DimensionSetItem {
  setId   Int
  typeId  String
  valueId String

  set   DimensionSet   @relation(fields: [setId], references: [id], onDelete: Cascade)
  type  DimensionType  @relation(fields: [typeId], references: [id])
  value DimensionValue @relation(fields: [valueId], references: [id])

  @@id([setId, typeId])
  @@index([valueId])
  @@map("dimension_set_items")
}

// ───────────────────────── چارت حساب‌ها

enum AccountLevel {
  GROUP // گروه
  GL // کل
  SUBSIDIARY // معین
}

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  MEMO
}

enum NormalSide {
  DEBIT
  CREDIT
  BOTH
}

enum DimRequirement {
  REQUIRED
  OPTIONAL
  FORBIDDEN
}

model Chart {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  isGroupTemplate Boolean  @default(false)
  createdAt       DateTime @default(now())

  accounts Account[]
  entities Entity[]

  @@map("charts")
}

model Account {
  id          String          @id @default(cuid())
  chartId     String
  code        String
  name        String
  level       AccountLevel
  parentId    String?
  category    AccountCategory
  normalSide  NormalSide
  isPostable  Boolean         @default(false)
  allowFx     Boolean         @default(false)
  // برچسب‌ها برای داشبورد و گزارش‌ها: CASH, RECEIVABLE, PAYABLE, LOAN, INVESTMENT, CURRENT, NON_CURRENT, COGS, OPEX, FINANCE, OTHER_INCOME
  tags        String[]        @default([])
  // نقش سیستمی (یکتا در چارت): RETAINED_EARNINGS و ...
  systemRole  String?
  description String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  chart    Chart                  @relation(fields: [chartId], references: [id])
  parent   Account?               @relation("AccountTree", fields: [parentId], references: [id])
  children Account[]              @relation("AccountTree")
  rules        AccountDimensionRule[]
  lines        VoucherLine[]
  bankAccounts BankAccount[]
  allocations  TreasuryAllocation[]
  invoiceLines InvoiceLine[]
  balances GlBalance[]

  @@unique([chartId, code])
  @@unique([chartId, systemRole])
  @@map("accounts")
}

model AccountDimensionRule {
  accountId       String
  dimensionTypeId String
  requirement     DimRequirement
  position        Int            @default(1)

  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  dimensionType DimensionType @relation(fields: [dimensionTypeId], references: [id])

  @@id([accountId, dimensionTypeId])
  @@map("account_dimension_rules")
}

// ───────────────────────── اسناد حسابداری

enum VoucherType {
  OPENING // افتتاحیه
  NORMAL // عادی
  ADJUSTMENT // اصلاحی
  ALLOCATION // تسهیم
  REVERSAL // برگشت
  SYSTEM // صادره از زیرسیستم‌ها
  PL_CLOSING // بستن حساب‌های موقت
  CLOSING // اختتامیه
}

enum VoucherStatus {
  DRAFT // یادداشت
  REVIEWED // بررسی‌شده
  POSTED // قطعی
}

model Voucher {
  id             String        @id @default(cuid())
  entityId       String
  fiscalYearId   String
  periodId       String
  number         Int? // شماره قطعی — هنگام قطعی شدن، بدون فاصله
  draftNo        Int // شماره موقت
  dailyNo        Int?
  date           DateTime      @db.Date
  type           VoucherType   @default(NORMAL)
  status         VoucherStatus @default(DRAFT)
  description    String?
  sourceModule   String?
  sourceRef      String?
  idempotencyKey String?       @unique
  reversalOfId   String?       @unique
  totalAmount    BigInt        @default(0)
  createdById    String
  reviewedById   String?
  postedById     String?
  postedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  entity     Entity        @relation(fields: [entityId], references: [id])
  fiscalYear FiscalYear    @relation(fields: [fiscalYearId], references: [id])
  period     FiscalPeriod  @relation(fields: [periodId], references: [id])
  reversalOf Voucher?      @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy Voucher?      @relation("Reversal")
  createdBy  User          @relation("VoucherCreatedBy", fields: [createdById], references: [id])
  reviewedBy User?         @relation("VoucherReviewedBy", fields: [reviewedById], references: [id])
  postedBy   User?         @relation("VoucherPostedBy", fields: [postedById], references: [id])
  lines        VoucherLine[]
  treasuryTxns TreasuryTxn[] @relation("TreasuryVoucher")
  chequeEvents ChequeEvent[] @relation("ChequeEventVoucher")
  invoice      Invoice?      @relation("InvoiceVoucher")
  ingestEvents IngestEvent[] @relation("IngestVoucher")
  payrollRun   PayrollRun?   @relation("PayrollVoucher")
  employeeLoans EmployeeLoan[] @relation("EmployeeLoanVoucher")
  allocationRun AllocationRun? @relation("AllocationVoucher")

  @@unique([fiscalYearId, number])
  @@unique([fiscalYearId, draftNo])
  @@index([entityId, date])
  @@index([status])
  @@map("vouchers")
}

model VoucherLine {
  id             String    @id @default(cuid())
  voucherId      String
  lineNo         Int
  accountId      String
  dimensionSetId Int
  debit          BigInt    @default(0)
  credit         BigInt    @default(0)
  currency       String?
  fxAmount       Decimal?  @db.Decimal(28, 6)
  fxRate         Decimal?  @db.Decimal(24, 6)
  quantity       Decimal?  @db.Decimal(28, 10)
  unit           String?
  dueDate        DateTime? @db.Date
  description    String?

  voucher      Voucher      @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])
  dimensionSet DimensionSet @relation(fields: [dimensionSetId], references: [id])

  @@index([voucherId])
  @@index([accountId])
  @@index([dimensionSetId])
  @@map("voucher_lines")
}

// مانده‌های تجمیعی — هنگام قطعی شدن سند به‌روز می‌شود (برای داشبورد)
model GlBalance {
  entityId       String
  periodId       String
  accountId      String
  dimensionSetId Int
  debit          BigInt @default(0)
  credit         BigInt @default(0)

  period       FiscalPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])
  dimensionSet DimensionSet @relation(fields: [dimensionSetId], references: [id])

  @@id([periodId, accountId, dimensionSetId])
  @@index([entityId])
  @@map("gl_balances")
}

model NumberSequence {
  key   String @id
  value Int    @default(0)

  @@map("number_sequences")
}

model ExchangeRate {
  id       String   @id @default(cuid())
  currency String
  date     DateTime @db.Date
  rate     Decimal  @db.Decimal(24, 6)
  source   String   @default("manual")

  @@unique([currency, date, source])
  @@map("exchange_rates")
}

// ───────────────────────── کاربران، دسترسی و ممیزی

enum Role {
  ADMIN // مدیر سیستم
  FINANCE_MANAGER // مدیر مالی — قطعی کردن، برگشت، قفل دوره
  ACCOUNTANT // حسابدار — ثبت و ویرایش یادداشت
  VIEWER // فقط مشاهده
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(ACCOUNTANT)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  scopes           UserScope[]
  vouchersCreated  Voucher[]   @relation("VoucherCreatedBy")
  vouchersReviewed Voucher[]   @relation("VoucherReviewedBy")
  vouchersPosted   Voucher[]   @relation("VoucherPostedBy")
  chequesCreated   Cheque[]
  chequeEvents     ChequeEvent[]
  treasuryTxns     TreasuryTxn[]
  invoices         Invoice[]
  settlements      Settlement[]
  employees        Employee[]
  employeeLoans    EmployeeLoan[]
  payrollRuns      PayrollRun[]
  allocationRuns   AllocationRun[]
  voucherTemplates VoucherTemplate[]

  @@map("users")
}

// محدودهٔ داده: بدون ردیف = دسترسی به همه
model UserScope {
  id               String  @id @default(cuid())
  userId           String
  entityId         String?
  dimensionValueId String?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity         Entity?         @relation(fields: [entityId], references: [id])
  dimensionValue DimensionValue? @relation(fields: [dimensionValueId], references: [id])

  @@map("user_scopes")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  userId     String?
  action     String
  objectType String
  objectId   String?
  entityId   String?
  data       Json?
  prevHash   String?
  hash       String

  @@index([objectType, objectId])
  @@map("audit_log")
}

// ───────────────────────── فاز ۲: اشخاص، بانک و صندوق، خزانه، چک

enum PartyKind {
  PERSON
  COMPANY
}

/// طرف حساب: مشتری، تأمین‌کننده، کارمند، سهامدار… (به یک مقدار بُعد PARTY وصل است)
model Party {
  id               String    @id @default(cuid())
  dimensionValueId String    @unique
  entityId         String?
  kind             PartyKind @default(COMPANY)
  nationalCode     String?
  economicCode     String?
  registrationNo   String?
  phone            String?
  mobile           String?
  email            String?
  address          String?
  bankName         String?
  accountNo        String?
  iban             String?
  roles            String[]  @default([])
  notes            String?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  dimensionValue DimensionValue       @relation(fields: [dimensionValueId], references: [id], onDelete: Cascade)
  entity         Entity?              @relation(fields: [entityId], references: [id])
  bankAccounts   BankAccount[]
  cheques        Cheque[]
  chequeEvents   ChequeEvent[]
  treasuryTxns   TreasuryTxn[]
  allocations    TreasuryAllocation[]
  invoices       Invoice[]
  employee       Employee?

  @@map("parties")
}

enum BankAccountKind {
  BANK
  CASH
  PETTY_CASH
}

/// حساب بانکی، صندوق یا تنخواه (به یک مقدار بُعد BANK_ACCOUNT وصل است)
model BankAccount {
  id               String          @id @default(cuid())
  dimensionValueId String          @unique
  entityId         String
  kind             BankAccountKind @default(BANK)
  bankName         String?
  branch           String?
  accountNo        String?
  iban             String?
  cardNo           String?
  currency         String          @default("IRR")
  glAccountId      String
  custodianPartyId String?
  description      String?
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  dimensionValue DimensionValue @relation(fields: [dimensionValueId], references: [id], onDelete: Cascade)
  entity         Entity         @relation(fields: [entityId], references: [id])
  glAccount      Account        @relation(fields: [glAccountId], references: [id])
  custodian      Party?         @relation(fields: [custodianPartyId], references: [id])
  chequeBooks    ChequeBook[]
  cheques        Cheque[]
  chequeEvents   ChequeEvent[]
  items          TreasuryItem[] @relation("ItemBank")
  itemsTo        TreasuryItem[] @relation("ItemBankTo")

  @@map("bank_accounts")
}

/// قالب چاپ چک — مختصات هر فیلد روی برگهٔ چک بر حسب میلی‌متر
model ChequeLayout {
  id        String   @id @default(cuid())
  name      String
  bankName  String?
  widthMm   Float    @default(195)
  heightMm  Float    @default(85)
  offsetXMm Float    @default(0)
  offsetYMm Float    @default(0)
  fields    Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chequeBooks ChequeBook[]

  @@map("cheque_layouts")
}

model ChequeBook {
  id            String   @id @default(cuid())
  bankAccountId String
  name          String
  serialFrom    String?
  serialTo      String?
  layoutId      String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  bankAccount BankAccount   @relation(fields: [bankAccountId], references: [id])
  layout      ChequeLayout? @relation(fields: [layoutId], references: [id])
  cheques     Cheque[]

  @@map("cheque_books")
}

enum ChequeDirection {
  RECEIVED
  ISSUED
}

enum ChequeStatus {
  IN_HAND
  DEPOSITED
  CLEARED
  ENDORSED
  ISSUED
  PAID
  BOUNCED
  RETURNED
  CANCELLED
}

model Cheque {
  id               String          @id @default(cuid())
  entityId         String
  direction        ChequeDirection
  status           ChequeStatus
  bankAccountId    String?
  chequeBookId     String?
  serialNo         String
  sayadId          String?
  bankName         String?
  branch           String?
  accountNo        String?
  drawerName       String?
  amount           BigInt
  issueDate        DateTime?       @db.Date
  dueDate          DateTime        @db.Date
  partyId          String?
  counterpartyName String?
  description      String?
  businessDimId    String?
  projectDimId     String?
  isGuarantee      Boolean         @default(false)
  location         String?
  printedAt        DateTime?
  printCount       Int             @default(0)
  createdById      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  entity      Entity         @relation(fields: [entityId], references: [id])
  bankAccount BankAccount?   @relation(fields: [bankAccountId], references: [id])
  chequeBook  ChequeBook?    @relation(fields: [chequeBookId], references: [id])
  party       Party?         @relation(fields: [partyId], references: [id])
  createdBy   User           @relation(fields: [createdById], references: [id])
  events      ChequeEvent[]
  items       TreasuryItem[]

  @@index([entityId, direction, status])
  @@index([dueDate])
  @@map("cheques")
}

enum ChequeEventType {
  REGISTER
  DEPOSIT
  CLEAR
  BOUNCE
  ENDORSE
  RETURN
  CANCEL
  PAY
  NOTE
}

model ChequeEvent {
  id            String          @id @default(cuid())
  chequeId      String
  type          ChequeEventType
  date          DateTime        @db.Date
  description   String?
  voucherId     String?
  bankAccountId String?
  partyId       String?
  feeAmount     BigInt          @default(0)
  createdById   String
  createdAt     DateTime        @default(now())

  cheque      Cheque       @relation(fields: [chequeId], references: [id], onDelete: Cascade)
  voucher     Voucher?     @relation("ChequeEventVoucher", fields: [voucherId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
  party       Party?       @relation(fields: [partyId], references: [id])
  createdBy   User         @relation(fields: [createdById], references: [id])

  @@index([chequeId])
  @@map("cheque_events")
}

enum TreasuryType {
  RECEIPT
  PAYMENT
  TRANSFER
}

enum TreasuryStatus {
  DRAFT
  POSTED
}

model TreasuryTxn {
  id            String         @id @default(cuid())
  entityId      String
  type          TreasuryType
  number        Int
  date          DateTime       @db.Date
  partyId       String?
  description   String?
  businessDimId String?
  projectDimId  String?
  totalAmount   BigInt         @default(0)
  status        TreasuryStatus @default(DRAFT)
  voucherId     String?        @unique
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  entity      Entity               @relation(fields: [entityId], references: [id])
  party       Party?               @relation(fields: [partyId], references: [id])
  voucher     Voucher?             @relation("TreasuryVoucher", fields: [voucherId], references: [id])
  createdBy   User                 @relation(fields: [createdById], references: [id])
  items       TreasuryItem[]
  allocations TreasuryAllocation[]
  settlements Settlement[]

  @@unique([entityId, type, number])
  @@index([entityId, date])
  @@map("treasury_txns")
}

enum PayMethod {
  CASH
  BANK
  CARD
  GATEWAY
  CHEQUE_NEW
  CHEQUE_ENDORSE
}

/// «از طریق چه چیزی» پول جابه‌جا شد
model TreasuryItem {
  id              String    @id @default(cuid())
  txnId           String
  method          PayMethod
  bankAccountId   String?
  toBankAccountId String?
  chequeId        String?
  amount          BigInt
  feeAmount       BigInt    @default(0)
  reference       String?
  description     String?
  meta            Json?

  txn           TreasuryTxn  @relation(fields: [txnId], references: [id], onDelete: Cascade)
  bankAccount   BankAccount? @relation("ItemBank", fields: [bankAccountId], references: [id])
  toBankAccount BankAccount? @relation("ItemBankTo", fields: [toBankAccountId], references: [id])
  cheque        Cheque?      @relation(fields: [chequeId], references: [id])

  @@index([txnId])
  @@map("treasury_items")
}

/// «بابت چه حسابی» بود
model TreasuryAllocation {
  id              String  @id @default(cuid())
  txnId           String
  accountId       String
  partyId         String?
  businessDimId   String?
  costCenterDimId String?
  projectDimId    String?
  invoiceId       String?
  amount          BigInt
  description     String?

  invoice Invoice?    @relation(fields: [invoiceId], references: [id])
  txn     TreasuryTxn @relation(fields: [txnId], references: [id], onDelete: Cascade)
  account Account     @relation(fields: [accountId], references: [id])
  party   Party?      @relation(fields: [partyId], references: [id])

  @@index([txnId])
  @@map("treasury_allocations")
}

// ───────────────────────── فاز ۳: فاکتور، تطبیق، اتصال سایت‌ها، تسهیم، قالب سند

enum InvoiceType {
  SALES // فروش
  PURCHASE // خرید
  SALES_RETURN // برگشت از فروش
  PURCHASE_RETURN // برگشت از خرید
}

enum InvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

model Invoice {
  id            String        @id @default(cuid())
  entityId      String
  type          InvoiceType
  number        Int
  date          DateTime      @db.Date
  dueDate       DateTime?     @db.Date
  partyId       String
  businessDimId String?
  projectDimId  String?
  reference     String? // شمارهٔ فاکتور طرف مقابل
  description   String?
  subtotal      BigInt        @default(0)
  discount      BigInt        @default(0)
  taxAmount     BigInt        @default(0)
  total         BigInt        @default(0)
  settledAmount BigInt        @default(0)
  status        InvoiceStatus @default(DRAFT)
  voucherId     String?       @unique
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  entity      Entity        @relation(fields: [entityId], references: [id])
  party       Party         @relation(fields: [partyId], references: [id])
  voucher     Voucher?      @relation("InvoiceVoucher", fields: [voucherId], references: [id])
  createdBy   User          @relation(fields: [createdById], references: [id])
  lines       InvoiceLine[]
  settlements Settlement[]
  allocations TreasuryAllocation[]

  @@unique([entityId, type, number])
  @@index([entityId, date])
  @@index([partyId])
  @@map("invoices")
}

model InvoiceLine {
  id              String   @id @default(cuid())
  invoiceId       String
  lineNo          Int
  title           String
  accountId       String
  quantity        Decimal  @default(1) @db.Decimal(18, 4)
  unitPrice       BigInt
  discount        BigInt   @default(0)
  taxRate         Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount       BigInt   @default(0)
  amount          BigInt   @default(0)
  businessDimId   String?
  costCenterDimId String?
  projectDimId    String?
  description     String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@index([invoiceId])
  @@map("invoice_lines")
}

/// تطبیق دریافت/پرداخت با فاکتور
model Settlement {
  id            String   @id @default(cuid())
  invoiceId     String
  treasuryTxnId String?
  amount        BigInt
  date          DateTime @db.Date
  note          String?
  createdById   String
  createdAt     DateTime @default(now())

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  treasuryTxn TreasuryTxn? @relation(fields: [treasuryTxnId], references: [id])
  createdBy   User         @relation(fields: [createdById], references: [id])

  @@index([invoiceId])
  @@map("settlements")
}

/// منبع رویداد (هر سایت یک منبع)
model IngestSource {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  entityId      String
  businessDimId String
  secretHash    String
  config        Json?
  active        Boolean       @default(true)
  lastEventAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  entity Entity        @relation(fields: [entityId], references: [id])
  events IngestEvent[]

  @@map("ingest_sources")
}

enum IngestStatus {
  PENDING
  POSTED
  FAILED
  IGNORED
}

model IngestEvent {
  id          String       @id @default(cuid())
  sourceId    String
  type        String
  externalId  String
  payload     Json
  amount      BigInt?
  status      IngestStatus @default(PENDING)
  error       String?
  voucherId   String?
  receivedAt  DateTime     @default(now())
  processedAt DateTime?

  source  IngestSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  voucher Voucher?     @relation("IngestVoucher", fields: [voucherId], references: [id])

  @@unique([sourceId, externalId])
  @@index([status])
  @@index([sourceId, receivedAt])
  @@map("ingest_events")
}

enum AllocationMethod {
  FIXED // درصد ثابت
  EQUAL // تقسیم مساوی
  REVENUE_SHARE // به نسبت درآمد دوره
}

model AllocationRule {
  id                 String           @id @default(cuid())
  entityId           String
  name               String
  method             AllocationMethod @default(REVENUE_SHARE)
  sourceBusinessDimId String?
  accountCodes       String[]         @default([])
  weights            Json?
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  entity Entity          @relation(fields: [entityId], references: [id])
  runs   AllocationRun[]

  @@map("allocation_rules")
}

model AllocationRun {
  id          String   @id @default(cuid())
  ruleId      String
  entityId    String
  periodId    String
  voucherId   String?  @unique
  totalAmount BigInt   @default(0)
  detail      Json?
  createdById String
  createdAt   DateTime @default(now())

  rule      AllocationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  period    FiscalPeriod   @relation(fields: [periodId], references: [id])
  voucher   Voucher?       @relation("AllocationVoucher", fields: [voucherId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])

  @@unique([ruleId, periodId])
  @@map("allocation_runs")
}

enum RecurrenceKind {
  NONE
  MONTHLY
}

/// قالب سند برای ثبت‌های تکراری (حقوق، اجاره، استهلاک و…)
model VoucherTemplate {
  id          String         @id @default(cuid())
  entityId    String
  name        String
  description String?
  voucherType VoucherType    @default(NORMAL)
  lines       Json
  recurrence  RecurrenceKind @default(NONE)
  dayOfMonth  Int            @default(1)
  active      Boolean        @default(true)
  lastUsedAt  DateTime?
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  entity    Entity @relation(fields: [entityId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  @@map("voucher_templates")
}

// ───────────────────────── فاز ۴: کارکنان، حقوق و دستمزد

enum EmployeeStatus {
  ACTIVE // شاغل
  ON_LEAVE // مرخصی بلندمدت
  SUSPENDED // تعلیق
  TERMINATED // پایان همکاری
}

enum ContractType {
  PERMANENT // دائم
  TEMPORARY // مدت معین
  PROJECT // پروژه‌ای
  HOURLY // ساعتی
  CONTRACTOR // پیمانکار / حق‌التدریس
  INTERN // کارآموز
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
}

model Employee {
  id             String         @id @default(cuid())
  entityId       String
  partyId        String         @unique
  code           String
  firstName      String
  lastName       String
  fatherName     String?
  nationalCode   String?
  idNumber       String? // شمارهٔ شناسنامه
  birthDate      DateTime?      @db.Date
  gender         Gender         @default(MALE)
  maritalStatus  MaritalStatus  @default(SINGLE)
  childrenCount  Int            @default(0)
  mobile         String?
  phone          String?
  email          String?
  address        String?
  emergencyName  String?
  emergencyPhone String?

  hireDate        DateTime      @db.Date
  contractType    ContractType  @default(PERMANENT)
  position        String? // سمت
  businessDimId   String?
  costCenterDimId String?
  managerId       String?

  insuranceNo     String? // شمارهٔ بیمه
  insured         Boolean  @default(true)
  taxFileNo       String?
  taxExempt       Boolean  @default(false)

  bankName  String?
  accountNo String?
  iban      String?

  baseSalary         BigInt @default(0) // حقوق پایهٔ ماهانه
  housingAllowance   BigInt @default(0) // حق مسکن
  foodAllowance      BigInt @default(0) // بن خواربار
  childAllowance     BigInt @default(0) // حق اولاد (۰ یعنی از تنظیمات محاسبه شود)
  transportAllowance BigInt @default(0) // ایاب و ذهاب
  otherAllowance     BigInt @default(0) // سایر مزایا
  severanceStartDate DateTime? @db.Date // مبنای محاسبهٔ سنوات (پیش‌فرض تاریخ استخدام)

  status            EmployeeStatus @default(ACTIVE)
  terminationDate   DateTime?      @db.Date
  terminationReason String?
  notes             String?
  createdById       String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  entity    Entity             @relation(fields: [entityId], references: [id])
  party     Party              @relation(fields: [partyId], references: [id])
  manager   Employee?          @relation("EmployeeManager", fields: [managerId], references: [id])
  reports   Employee[]         @relation("EmployeeManager")
  createdBy User               @relation(fields: [createdById], references: [id])
  contracts EmployeeContract[]
  payslips  PayrollItem[]
  loans     EmployeeLoan[]
  leaves    LeaveRecord[]

  @@unique([entityId, code])
  @@index([entityId, status])
  @@map("employees")
}

/// تاریخچهٔ قرارداد و حکم حقوقی
model EmployeeContract {
  id                 String       @id @default(cuid())
  employeeId         String
  startDate          DateTime     @db.Date
  endDate            DateTime?    @db.Date
  contractType       ContractType
  position           String?
  baseSalary         BigInt
  housingAllowance   BigInt       @default(0)
  foodAllowance      BigInt       @default(0)
  transportAllowance BigInt       @default(0)
  otherAllowance     BigInt       @default(0)
  note               String?
  createdAt          DateTime     @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_contracts")
}

enum LeaveType {
  ANNUAL // استحقاقی
  SICK // استعلاجی
  UNPAID // بدون حقوق
  MISSION // مأموریت
  OTHER
}

model LeaveRecord {
  id         String    @id @default(cuid())
  employeeId String
  type       LeaveType
  fromDate   DateTime  @db.Date
  toDate     DateTime  @db.Date
  days       Decimal   @db.Decimal(6, 2)
  note       String?
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("leave_records")
}

enum EmployeeLoanStatus {
  ACTIVE
  SETTLED
  CANCELLED
}

/// وام و مساعدهٔ کارکنان (از حقوق کسر می‌شود)
model EmployeeLoan {
  id                String             @id @default(cuid())
  employeeId        String
  date              DateTime           @db.Date
  amount            BigInt
  installmentAmount BigInt             @default(0)
  paidAmount        BigInt             @default(0)
  isAdvance         Boolean            @default(false) // مساعده (یک‌جا از حقوق همان ماه کسر می‌شود)
  description       String?
  voucherId         String?
  status            EmployeeLoanStatus @default(ACTIVE)
  createdById       String
  createdAt         DateTime           @default(now())

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  voucher   Voucher? @relation("EmployeeLoanVoucher", fields: [voucherId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([employeeId])
  @@map("employee_loans")
}

enum PayrollStatus {
  DRAFT
  POSTED
}

/// لیست حقوق یک ماه
model PayrollRun {
  id              String        @id @default(cuid())
  entityId        String
  periodId        String
  jy              Int
  jm              Int
  title           String
  payDate         DateTime?     @db.Date
  status          PayrollStatus @default(DRAFT)
  voucherId       String?       @unique
  totalGross      BigInt        @default(0)
  totalNet        BigInt        @default(0)
  totalTax        BigInt        @default(0)
  totalInsurance  BigInt        @default(0)
  totalEmployerCost BigInt      @default(0)
  settings        Json?
  note            String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  entity    Entity        @relation(fields: [entityId], references: [id])
  period    FiscalPeriod  @relation(fields: [periodId], references: [id])
  voucher   Voucher?      @relation("PayrollVoucher", fields: [voucherId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])
  items     PayrollItem[]

  @@unique([entityId, jy, jm])
  @@map("payroll_runs")
}

/// فیش حقوقی یک کارمند در یک ماه
model PayrollItem {
  id         String @id @default(cuid())
  runId      String
  employeeId String

  workingDays       Decimal @default(30) @db.Decimal(6, 2)
  absenceDays       Decimal @default(0) @db.Decimal(6, 2)
  overtimeHours     Decimal @default(0) @db.Decimal(8, 2)
  holidayHours      Decimal @default(0) @db.Decimal(8, 2)
  nightHours        Decimal @default(0) @db.Decimal(8, 2)
  missionDays       Decimal @default(0) @db.Decimal(6, 2)

  baseAmount         BigInt @default(0)
  housingAllowance   BigInt @default(0)
  foodAllowance      BigInt @default(0)
  childAllowance     BigInt @default(0)
  transportAllowance BigInt @default(0)
  otherAllowance     BigInt @default(0)
  overtimeAmount     BigInt @default(0)
  holidayAmount      BigInt @default(0)
  nightAmount        BigInt @default(0)
  missionAmount      BigInt @default(0)
  bonus              BigInt @default(0)
  grossEarnings      BigInt @default(0)

  insuranceBase     BigInt @default(0)
  insuranceEmployee BigInt @default(0)
  insuranceEmployer BigInt @default(0)
  taxBase           BigInt @default(0)
  tax               BigInt @default(0)
  loanDeduction     BigInt @default(0)
  advanceDeduction  BigInt @default(0)
  otherDeduction    BigInt @default(0)
  totalDeductions   BigInt @default(0)
  netPay            BigInt @default(0)

  severanceAccrual BigInt @default(0)
  leaveAccrual     BigInt @default(0)
  employerCost     BigInt @default(0)

  note String?

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id])

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@map("payroll_items")
}

/// نرخ‌ها و حساب‌های حقوق و دستمزد برای هر سال (قابل ویرایش در پنل)
model PayrollSettings {
  id       String @id @default(cuid())
  entityId String
  jy       Int

  dailyMinWage       BigInt  @default(0)
  monthlyWorkHours   Decimal @default(192) @db.Decimal(6, 2)
  insuranceEmployeeRate Decimal @default(7) @db.Decimal(5, 2)
  insuranceEmployerRate Decimal @default(23) @db.Decimal(5, 2)
  insuranceCeiling   BigInt  @default(0) // سقف دستمزد مشمول بیمه (۰ = بدون سقف)
  taxExemptMonthly   BigInt  @default(0)
  taxBrackets        Json // [{ to: number|null, rate: number }]
  childAllowanceRate BigInt  @default(0) // به ازای هر فرزند
  housingDefault     BigInt  @default(0)
  foodDefault        BigInt  @default(0)
  overtimeFactor     Decimal @default(1.4) @db.Decimal(5, 2)
  holidayFactor      Decimal @default(1.4) @db.Decimal(5, 2)
  nightFactor        Decimal @default(0.35) @db.Decimal(5, 2)
  severanceDaysPerYear Int   @default(30)
  accounts           Json // کدهای حساب
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id])

  @@unique([entityId, jy])
  @@map("payroll_settings")
}
